APP_NAME=Despashop
# En el servidor: APP_ENV=production y APP_DEBUG=false.
# Con APP_DEBUG=true cualquier error muestra el código y la configuración.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos. Crear con:
#   CREATE DATABASE catalogizador CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catalogizador
DB_USERNAME=catalogizador
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# El contenido de la sesión se guarda cifrado en la base. Al encenderlo
# por primera vez, las sesiones abiertas dejan de leerse y todos
# vuelven a entrar una vez; no da error, solo pide iniciar sesión.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Las imágenes de catálogos y facturas se sirven desde storage/app/public,
# así que hace falta ejecutar: php artisan storage:link
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@despashop.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Asistente de IA (Groq). Consigue una clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b
GROQ_MODELO_RESPALDO=openai/gpt-oss-20b
GROQ_MODELO_MODERACION=openai/gpt-oss-safeguard-20b
IA_LIMITE_DIARIO=3
IA_LIMITE_GLOBAL_DIARIO=150
IA_ESPERA_SEGUNDOS=30

# Registro de seguridad. El correo de aviso se elige en Admin > Ajustes;
# sin eso, el aviso va a todos los administradores.
SEGURIDAD_AVISOS=true
SEGURIDAD_ESPERA_AVISO=60
SEGURIDAD_UMBRAL_LOGIN=5
SEGURIDAD_UMBRAL_REGISTROS=4
SEGURIDAD_RETENCION_DIAS=120

# ── Producción ────────────────────────────────────────────────────────────────
# Copiar estos valores al servidor. La cookie de sesión solo viaja cifrada y
# la app genera todos sus enlaces con https://
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.despashop.com
# SANCTUM_STATEFUL_DOMAINS=despashop.com

# Respaldos (php artisan respaldo:crear, programado a las 2 a.m.)
RESPALDO_CONSERVAR=7
RESPALDO_ARCHIVOS=true
# Ruta a mysqldump si no está en el PATH del servidor
# RESPALDO_MYSQLDUMP=/usr/bin/mysqldump

# Planes vencidos: el catálogo se esconde al vencer y los datos se eliminan
# después de este plazo. Con PLANES_BORRADO_AUTOMATICO=false solo avisa.
PLANES_DIAS_DE_GRACIA=15
PLANES_BORRADO_AUTOMATICO=true
PLANES_DIAS_DE_PRUEBA=30
